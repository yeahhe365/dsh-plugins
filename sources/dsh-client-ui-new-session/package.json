{
  "name": "dsh-client-ui-new-session",
  "version": "1.3.0",
  "private": true,
  "description": "Composer new-conversation button: starts a new session in the current workspace from the left of the input tool row, carrying the current agent preset over.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ]
}
