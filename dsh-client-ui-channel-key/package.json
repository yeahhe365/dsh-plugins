{
  "name": "dsh-client-ui-channel-key",
  "version": "1.2.0",
  "private": true,
  "description": "Header button that edits the key pool of the model channel behind the current model selection, and the Host-side rotation that follows a rejected key. · 顶栏按钮：编辑当前模型渠道的密钥池；密钥被判失效时宿主自动换下一个。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/pool.js",
    "client/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/pool.test.mjs test/rotate.test.mjs test/probe.test.mjs test/wiring.test.mjs && node test/smoke.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "api-key",
    "model-channel",
    "key-pool"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
