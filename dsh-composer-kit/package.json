{
  "name": "dsh-composer-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Composer kit: new-session button, /compact button, brief-send button, dock wrap layout and the live call meter in one bundle. · 输入框工具件合集：新会话、压缩上下文、简而言之、状态行自动换行、调用频率计。",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "test": "node --test test/client.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "toolbar",
    "meter"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
